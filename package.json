{
  "name": "book-harvester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "types": "wrangler types --include-runtime false --strict-vars false",
    "migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/deploy.mjs",
    "test:browser": "node scripts/auth-browser-smoke.mjs && node scripts/browser-smoke.mjs && node scripts/expansion-smoke.mjs && node scripts/ideas-smoke.mjs && node scripts/theme-browser-smoke.mjs && node scripts/discovery-browser-smoke.mjs && node scripts/explicit-browser-smoke.mjs && node scripts/connections-browser-smoke.mjs",
    "connect:chatgpt": "node scripts/connect-chatgpt.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fast-xml-parser": "^5.5.8",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  }
}
